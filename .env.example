# Kopiér ikke denne fil manuelt - kør ./setup.sh, som genererer .env med tilfældige værdier.
# Her står kun nøglerne, ingen værdier.

# --- Hemmeligheder (genereres) ---
KEY=
SECRET=

# --- Admin (oprettes ved første start) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Database ---
DB_DATABASE=
DB_USER=
DB_PASSWORD=

# --- Adresse som mobilen bruger, fx http://192.168.1.23:8055 ---
PUBLIC_URL=

# --- Kørselsbruger for bind mounts (sættes af setup.sh) ---
HOST_UID=
HOST_GID=

# --- Valgfrit (har defaults i docker-compose.yml) ---
# DIRECTUS_PORT=
# DATA_DIR=
# FILES_MAX_UPLOAD_SIZE=
# TEKST_MAX_FIL_MB=
# TEKST_MAX_SIDER=
# TEKST_TIMEOUT_SEK=
# OCR_SLAAET_TIL=        (true/false; false = ingen OCR, som i 1.2.0)
# OCR_MAX_SIDER=         (højst så mange sider OCR'es pr. PDF; standard 50)
# OCR_TIMEOUT_SEK=       (tidsgrænse pr. side; standard 120)
# OCR_MAX_MEGAPIXEL=     (større billeder og scannede sider OCR'es ikke; standard 20)
# COOKIE_SECURE=

# --- Kodeord til testbrugere (genereres, bruges af scripts/provision.sh --seed) ---
TESTBRUGER_PASSWORD=

# --- Statisk token til servicebrugeren "Tekstservice" (genereres; sættes på brugeren af scripts/provision.sh) ---
TEKSTSERVICE_TOKEN=
